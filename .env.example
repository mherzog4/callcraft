# demo = all local previews; evaluation = seeded Gong + real OpenRouter/Slack/Gmail;
# production = all real providers. Do not combine APP_MODE with legacy DEMO_MODE.
APP_MODE=demo
APP_URL=http://localhost:3000
DATABASE_PATH=./data/app.db
EVAL_REPORT_DIRECTORY=./data/evals
MASTER_KEY=replace-with-at-least-32-random-characters
SESSION_SECRET=replace-with-at-least-32-random-characters
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
EVAL_MODELS=openai/gpt-4.1-mini,anthropic/claude-sonnet-4,google/gemini-2.5-flash
OPENROUTER_API_KEY=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GONG_BASE_URL=https://api.gong.io
GONG_ACCESS_KEY=
GONG_ACCESS_SECRET=
TRANSCRIPT_RETENTION_DAYS=7
LOG_LEVEL=info
# Optional. Any endpoint accepting a JSON POST receives fatal crash reports
# (component, reason, error name, stack frames only — never messages).
ERROR_WEBHOOK_URL=
