{
  "name": "callcraft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Production-minded transcript-to-follow-up Applied AI reference implementation",
  "license": "MIT",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:container": "tsx scripts/start-container.ts",
    "worker": "tsx --env-file=.env scripts/worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "demo:reset": "tsx --env-file=.env scripts/reset-demo.ts",
    "demo:verify": "tsx --env-file=.env scripts/verify-demo.ts",
    "evaluation:setup": "tsx scripts/setup-evaluation.ts",
    "evaluation:doctor": "tsx --env-file=.env scripts/evaluation-doctor.ts",
    "evaluation:start": "tsx --env-file=.env scripts/start-evaluation.ts",
    "acceptance:verify": "tsx --env-file=.env scripts/verify-live-acceptance.ts",
    "eval": "tsx scripts/eval.ts",
    "eval:live": "tsx --env-file=.env scripts/eval.ts --live",
    "eval:retrieval": "tsx --env-file=.env scripts/retrieval-eval.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:marketing && npm run eval && npm test && npm run build",
    "test:marketing": "html-validate marketing/index.html"
  },
  "dependencies": {
    "@slack/web-api": "^7.12.0",
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "^0.45.2",
    "googleapis": "^173.0.0",
    "next": "^16.3.0",
    "nodemailer": "^9.0.4",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sqlite-vec": "^0.1.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^7.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.3.0",
    "html-validate": "^11.6.2",
    "prettier": "^3.6.2",
    "tsx": "^4.23.9",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "sharp": "0.35.3",
    "esbuild": "0.28.1"
  }
}
