{
  "name": "gong-follow-up",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Production-minded Gong-to-Slack follow-up email assistant",
  "license": "MIT",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx scripts/worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "demo:reset": "tsx scripts/reset-demo.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@slack/web-api": "^7.12.0",
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "^0.45.2",
    "googleapis": "^173.0.0",
    "next": "^16.2.12",
    "nodemailer": "^9.0.3",
    "pino": "^9.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.6",
    "@types/nodemailer": "^7.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.2.12",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3",
    "esbuild": "0.28.1"
  }
}
